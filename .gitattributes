# Git LFS: large binary art files are stored in LFS, not in normal git history.
# Scoped to the art folders so existing Unity template files are untouched.
art/** filter=lfs diff=lfs merge=lfs -text
unity/client/Assets/Art/**/*.png filter=lfs diff=lfs merge=lfs -text
unity/client/Assets/Art/**/*.psd filter=lfs diff=lfs merge=lfs -text
unity/client/Assets/Art/**/*.kra filter=lfs diff=lfs merge=lfs -text
unity/client/Assets/Art/**/*.jpg filter=lfs diff=lfs merge=lfs -text
unity/client/Assets/Art/**/*.tif filter=lfs diff=lfs merge=lfs -text
unity/client/Assets/Art/**/*.wav filter=lfs diff=lfs merge=lfs -text
unity/client/Assets/Art/**/*.mp4 filter=lfs diff=lfs merge=lfs -text
